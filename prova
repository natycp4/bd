create table clientes(
    id int primary key, 
	nome varchar(100),
	cpf int,
	cidade varchar(100)
);

create table veiculos(
    id int primary key,
	modelo varchar(30),
	placa varchar(7),
	diaria real
);
create table locacoes(
	id int primary key,
	cliente_id int,
	veiculo_id int,
	data_retirada date,
	data_devolucao date,
	valor_total real,
	foreign key (cliente_id) references clientes(id),
	foreign key (veiculo_id) references veiculos(id)
);

